# Copy to .env and replace every value. The values below are placeholders;
# the app refuses to start with them outside development.

# Folder on the host with <customer>/<project>/… folders (mounted read-only).
PRINTS_ROOT=/path/to/your/3d-prints

# Host port for the web interface.
PORT=8080

TZ=Europe/Amsterdam
LOG_LEVEL=info

# Leave unset for SQLite on the data volume.
# DATABASE_URL=postgres://prints_portal:change-me@db:5432/prints_portal

# --- Sign-in ---

# Public address of the app, without a path (OIDC redirects and share links).
# PUBLIC_URL=https://prints.example.com

# At least 32 random characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

# First admin, created only when no admin exists yet (local login only).
# The password must be at least 12 characters and not this placeholder.
# Once the admin exists these are ignored; they never reset a password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME-to-a-long-password

# Login attempts per minute per address.
# RATE_LIMIT_LOGIN=5

# Requests per minute per address on the public share page, its PDF and its logo.
# RATE_LIMIT_SHARE=60

# OIDC (e.g. Authentik). Setting all four turns local login off; PUBLIC_URL is then required.
# OIDC_ISSUER=https://auth.example.com/application/o/prints-portal/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUP=prints-admins

# Behind a reverse proxy: the proxy's address(es), so HTTPS and client IPs are recognised.
# TRUSTED_PROXIES=172.18.0.0/16

# Spoolman (optional; empty hides spool features). Tested against Spoolman v0.27.0.
# SPOOLMAN_URL=http://spoolman:7912
# SPOOLMAN_TIMEOUT_MS=3000

# Electricity tariff in €/kWh, used only on the first start; then edit it as a setting.
# ELECTRICITY_TARIFF_EUR_PER_KWH=0.25


# --- Backups (the `backup` service in docker-compose.yml) ---

# Host folder for the backups. Must be writable by uid 1000 and should be on another disk.
# BACKUP_DIR=./backups
# Time of day the backup runs (24-hour clock, in TZ).
# BACKUP_TIME=03:00
# Retention: the newest backup of each of the last N days, weeks and months is kept.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
