# Copy to .env and replace every value. The values below are placeholders;
# from the auth milestone on, the app refuses them outside development.

# Folder on the host with <customer>/<project>/… folders (mounted read-only).
PRINTS_ROOT=/path/to/your/3d-prints

# Host port for the web interface.
PORT=8080

TZ=Europe/Amsterdam
LOG_LEVEL=info

# Leave unset for SQLite on the data volume.
# DATABASE_URL=postgres://prints_portal:change-me@db:5432/prints_portal

# --- Used from the auth milestone onwards ---

# Public address of the app (OIDC redirects and share links).
# PUBLIC_URL=https://prints.example.com

# At least 32 random characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

# First admin, created only when no admin exists yet.
# The password must be at least 12 characters and not this placeholder.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME-to-a-long-password

# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
